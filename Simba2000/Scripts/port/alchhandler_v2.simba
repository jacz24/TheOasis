{$DEFINE WL_ALCH_HANDLER_INCLUDED}
{$IFNDEF WL_OSRS}
  {$I WaspLib/osrs.simba}
{$ENDIF}

type
  TRSAlchHandler = record
    Name: String;
    Item: TRSItem;
    ItemArray: TRSItemArray;
    Timer: TCountDown;
    SlotUnder: Integer;
    LowProfit, HighProfit, TotalProfit: Integer;
    Disabled: Boolean;
    Config: TConfigJSON;
  end;

procedure TRSAlchHandler.DebugLn(msg: String);
begin
  WriteLn('[AlchHandler] ' + msg);
end;

procedure TRSAlchHandler.Fatal(msg: String);
begin
  WriteLn('[AlchHandler] FATAL: ' + msg);
  TerminateScript(msg);
end;

procedure TRSAlchHandler.SaveConfig();
var
  i: Integer;
  arr: TJSONArray;
begin
  // Remove existing items array if present
  if Self.Config.Data.Has('items') then
    Self.Config.Data.Delete(Self.Config.Data.Item['items']);

  // Create new array
  arr := new TJSONArray();
  for i := 0 to High(Self.ItemArray) do
    arr.AddString('item', String(Self.ItemArray[i]));

  Self.Config.Data.AddArray('items', arr);
  Self.Config.Save();
end;

procedure TRSAlchHandler.AddItem(item: TRSItem);
begin
  Self.ItemArray += item;
  Self.SaveConfig();
end;

