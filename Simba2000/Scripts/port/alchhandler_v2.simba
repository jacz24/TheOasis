procedure TRSAlchHandler.LoadItems();
var
  i: Integer;
  arr: TJSONItem;
begin
  if not Self.Config.Data.GetArray('items', arr) then
    Exit;

  for i := 0 to arr.Count - 1 do
    Self.ItemArray += arr.Item[i].AsString;
end;

procedure TRSAlchHandler.Setup();
begin
  Self.Name := 'Alcher';

  if Self.ItemArray <> [] then
    Exit;

  Self.Config.Setup('alchhandler');
  if not Self.Config.Data.Has('items') then
  begin
    Self.AddDefault();
    Self.SaveConfig();
    Exit;
  end;

  Self.LoadItems();
end;

function TRSAlchHandler.GetAlchItem(): TRSItem;
var
  match: TImageMatch;
begin
  if not Inventory.Open() then
    Exit;

  // Deselect any selected item/spell
  if Magic.ContainsSelected() then
    Magic.Deselect();

  if not ItemFinder.Find(Self.ItemArray, Inventory.Slots.Boxes(), match) then
  begin
    Self.DebugLn('No items in the alch list were found!');
    Self.Disabled := True;
    Exit;
  end;

  Result := Self.ItemArray[match.Index];
  Self.DebugLn('Found item: ' + String(Result));

  // Note: Profit calculation removed as ItemData API changed
  // You can add custom price lookup if needed
end;

procedure TRSAlchHandler.AddProfit(hi: Boolean = True);
begin
  if hi then
    Self.TotalProfit += Self.HighProfit
  else
    Self.TotalProfit += Self.LowProfit;
end;

function TRSAlchHandler.ClickEmptySlot(slot: Integer = -1): Boolean;
var
  slots: TIntegerArray;
  box: TBox;
begin
  slots := Inventory.Slots.GetEmpty();
  Result := slots <> [];

  if Result then
  begin
    if slot = -1 then
      slot := Inventory.Slots.GetUnder(Mouse.Position);

    if slot = -1 then
    begin
      // Click random empty slot
      slot := slots[Random(Length(slots))];
    end
    else
    begin
      if (slots.IndexOf(slot) = -1) or Biometrics.RandomBoolean(0.5) then
        slot := Inventory.Slots.RandomNear(slot, slots);
    end;

    box := Inventory.Slots.Box(slot);
    Mouse.Move(box);
    Mouse.Click(EMouseButton.LEFT);
  end;
end;

function TRSAlchHandler.DisableCast(): Boolean;
var
  i, attempt: Integer;
begin
  if Length(Inventory.Slots.GetUsed()) < 28 then
    i := Random(0, 2)
  else
    i := Random(3, 5);

  repeat
    if Inc(attempt) > 10 then
      Self.Fatal('Cannot disable the alchemy spell!');

    case i of
      0..2: Self.ClickEmptySlot();
      3: Mouse.Click(MainScreen.Bounds, EMouseButton.LEFT);
      4: Mouse.Click(Chat.Bounds, EMouseButton.LEFT);
      5: ChooseOption.Select('Cancel');
    end;
  until not MainScreen.IsUpText('Alchemy -');
  Result := True;
end;

function TRSAlchHandler.SelectSpell(hi: Boolean = True): Boolean;
var
  attempt: Integer;
  spellStr: String;
  spell: ERSSpell;
begin
  if hi then
  begin
    spell := ERSSpell.HIGH_LEVEL_ALCHEMY;
    spellStr := 'h Level Alchemy -';
  end
  else
  begin
    spell := ERSSpell.LOW_LEVEL_ALCHEMY;
    spellStr := 'w Level Alchemy -';
  end;

  repeat
    if not Magic.IsSelected(spell) or not Inventory.IsOpen() then
      Magic.CastSpell(spell);

    Result := MainScreen.IsUpText(spellStr) or Inventory.IsOpen();
  until Result or (Inc(attempt) > 3);

  Self.Disabled := not Result;
end;

function TRSAlchHandler.SelectItem(hi: Boolean = True; waitTimer: Boolean = False): Boolean;
var
  attempt, slot, spellSlot: Integer;
  box: TBox;
  slots: TIntegerArray;
begin
  // Timer will be started after successful alch
  // High alch: 5 ticks (3000ms), Low alch: 3 ticks (1800ms)

  spellSlot := Self.SlotUnder;

  for attempt := 0 to 2 do
  begin
    if String(Self.Item) = '' then
      Self.Item := Self.GetAlchItem();

    if String(Self.Item) = '' then
      Exit;

    if Inventory.Items.Find(Self.Item, slot) then
    begin
      // Check if item needs to be moved under spell
      if (slot <> spellSlot) and (Inventory.Slots.ReadStack(slot) > 0) then
      begin
        Self.DisableCast();
        // Item moving would need custom implementation
        // For now, just continue
        Break;
      end;

      if Random(1000) < 995 then  // 99.5% chance
      begin
        box := Inventory.Slots.Box(slot);
        Mouse.Move(box);

        if not MainScreen.IsUpText('>') then
          Exit;

        if not waitTimer then
        begin
          if not Self.Timer.IsFinished then
            Exit;
        end
        else
          SleepUntil(Self.Timer.IsFinished, 50, 3100);

        Mouse.Click(EMouseButton.LEFT);

        if not SleepUntil(XPBar.EarnedXP() or Magic.IsOpen(), 300, 3000) then
          Exit;

        if hi then
          Self.Timer.Start(5 * 600)  // High alch: 5 ticks
        else
          Self.Timer.Start(3 * 600); // Low alch: 3 ticks
        Self.AddProfit(hi);
        Exit(True);
      end;

      slots := Inventory.Slots.GetEmpty();
      if slots <> [] then
      begin
        slot := Inventory.Slots.RandomNear(slot, slots);
        box := Inventory.Slots.Box(slot);
        Mouse.Move(box);
        if MainScreen.IsUpText('>') then
          Mouse.Click(EMouseButton.LEFT);
      end;
      Exit;
    end
    else
    begin
      // Check equipment for the item
      Self.DisableCast();
      if Equipment.Items.Find(Self.Item, box) then
      begin
        Mouse.Click(box, EMouseButton.LEFT);
        Exit;
      end;
    end;

    Self.Item := '';
  end;
end;

function TRSAlchHandler.CastAlchemy(hi: Boolean = True; waitTimer: Boolean = False): Boolean;
var
  attempt: Integer;
begin
  XPBar.EarnedXP(); // Update cached XP

  repeat
    if not Self.SelectSpell(hi) then
      Exit;
    Result := Self.SelectItem(hi, waitTimer);
  until Result or (Inc(attempt) > 2);
end;

var
  RSAlchHandler: TRSAlchHandler;

// Initialize the alch handler
procedure InitAlchHandler();
begin
  RSAlchHandler.Setup();
end;

// Override Magic.FindSpell to track which inventory slot is under the spell
function TRSMagic.FindSpell(spell: ERSSpell; out box: TBox; attempts: Integer = 2): Boolean; override;
var
  slots: TBoxArray;
  i: Integer;
begin
  Result := inherited(spell, box, attempts);

  if not Result then
    Exit;

  if (spell <> ERSSpell.LOW_LEVEL_ALCHEMY) and
     (spell <> ERSSpell.HIGH_LEVEL_ALCHEMY) then
    Exit;

  slots := Inventory.Slots.Boxes();
  for i := 0 to High(slots) do
    if box.Overlap(slots[i]) then
    begin
      RSAlchHandler.SlotUnder := i;
      Exit;
    end;
end;
